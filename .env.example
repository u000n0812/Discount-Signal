# Postgres 연결 주소 (몽블랑과 다른 데이터베이스를 쓰세요)
DATABASE_URL="postgresql://user:password@localhost:5432/signal?schema=public"

# Google AI Studio(https://aistudio.google.com/apikey)에서 발급하는 무료 Gemini API 키
# 없어도 동작해요. 없으면 브랜드 페이지 판정이 키워드 방식으로 물러납니다.
GEMINI_API_KEY="your-gemini-api-key"

# 크론 보호용 비밀값. 없으면 /api/cron은 503으로 닫혀 있어요.
CRON_SECRET="a-long-random-string"
