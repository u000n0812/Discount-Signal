generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WatchKind {
  STEAM
  WEB
}

model Watch {
  id     String    @id @default(cuid())
  userId String
  kind   WatchKind

  /// 목록에 보여줄 이름 (게임 제목이나 브랜드 이름)
  label String
  /// 사용자가 자연어로 적은 추가 조건. 예: "DLC 말고 본편만"
  condition String?

  /// 알림 기준: 할인율(%) 이상이거나 목표가(원) 이하일 때
  minDiscount Int?
  targetPrice Int?

  /// STEAM 감시
  steamAppId Int?

  /// WEB 감시
  url String?

  active Boolean @default(true)

  /// 같은 세일로 중복 알림이 가지 않도록 마지막 상태를 기억한다.
  lastSignature String?
  lastCheckedAt DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  alerts    Alert[]

  @@index([userId, createdAt])
  @@index([active, lastCheckedAt])
}

model Alert {
  id      String @id @default(cuid())
  userId  String
  watchId String
  watch   Watch  @relation(fields: [watchId], references: [id], onDelete: Cascade)

  title           String
  source          String
  url             String?
  priceNow        Int?
  priceWas        Int?
  discountPercent Int?
  currency        String  @default("KRW")

  /// 매칭 근거 — 몇 %로 일치했고 어떤 조건이 충족됐는지
  matchScore Int
  reason     String

  /// 같은 세일을 다시 알리지 않기 위한 식별자
  signature String

  dismissed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([watchId, signature])
  @@index([userId, createdAt])
}

/// 사용자별 알림 설정
model Setting {
  userId String @id

  /// 매칭 민감도 — 이 점수 이상만 알림으로 남긴다.
  minScore Int @default(70)
  /// 탭이 열려 있을 때 브라우저 알림을 띄울지
  browserNotify Boolean @default(true)

  updatedAt DateTime @updatedAt
}
